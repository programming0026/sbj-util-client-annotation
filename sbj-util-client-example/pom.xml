<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.2</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>com.juniverse.client.example</groupId>
	<artifactId>sbj-util-client-example</artifactId>
	<version>1.0.0-SNAPSHOT</version>
	<name>sbj-util-client-example</name>
	<description>Example of using sbj-util-client to consume the DummyJSON API, following a hexagonal architecture</description>
	<url>https://github.com/programming0026/sbj-util-client-annotation</url>
	<licenses>
		<license>
			<name>MIT License</name>
			<url>https://opensource.org/license/mit</url>
		</license>
	</licenses>
	<developers>
		<developer>
			<id>programming0026</id>
			<name>programming0026</name>
			<email>programming0026@gmail.com</email>
		</developer>
	</developers>
	<scm>
		<connection>scm:git:https://github.com/programming0026/sbj-util-client-annotation.git</connection>
		<developerConnection>scm:git:git@github.com:programming0026/sbj-util-client-annotation.git</developerConnection>
		<tag>HEAD</tag>
		<url>https://github.com/programming0026/sbj-util-client-annotation</url>
	</scm>
	<properties>
		<java.version>21</java.version>
		<sbj-util-client.version>2.0.0</sbj-util-client.version>
		<springdoc.version>3.2.0</springdoc.version>
	</properties>
	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
		</dependency>
		<dependency>
			<groupId>io.github.programming0026</groupId>
			<artifactId>sbj-util-client-annotation</artifactId>
			<version>${sbj-util-client.version}</version>
		</dependency>
		<dependency>
			<groupId>org.springdoc</groupId>
			<artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
			<version>${springdoc.version}</version>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
		</plugins>
	</build>

</project>
